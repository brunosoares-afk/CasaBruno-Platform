#!/usr/bin/env bash

ROOT="/opt/CasaBruno-Platform"

echo
echo "========== CBOS DOCTOR =========="
echo

DIRS=(
backend
frontend
tools
docs
ai
)

for dir in "${DIRS[@]}"
do
    if [ -d "$ROOT/$dir" ]; then
        printf "[ OK ] %-15s\n" "$dir"
    else
        printf "[FAIL] %-15s\n" "$dir"
    fi
done

echo
