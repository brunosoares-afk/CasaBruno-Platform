#!/usr/bin/env bash

ROOT="/opt/CasaBruno-Platform"

case "$1" in

apply)
    shift
    exec "$ROOT/installer/bin/apply" "$@"
    ;;

*)
    echo
    echo "========================================"
    echo "        CBOS INSTALLER"
    echo "========================================"
    echo
    echo "Comandos"
    echo
    echo "cbos-install apply <Sprint>"
    echo
    echo "Sprints disponíveis"
    echo
    find "$ROOT/installer/sprints" -mindepth 1 -maxdepth 1 -type d | sort | xargs -n1 basename
    echo
    ;;
esac
